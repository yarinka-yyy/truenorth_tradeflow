<UserControl x:Class="TrueNorth.TradeFlow.Account.AccountDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <Grid>
    <StackPanel x:Name="NoDataPanel">
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Доступность счёта" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Чтение балансов и позиций пока не подключено. Для реальных данных понадобится проверенный доступ к площадкам."
                     Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap" />
          <Button x:Name="ShowExampleButton" Style="{StaticResource PrimaryAction}"
                  Content="_Показать локальный пример" Click="ShowExample_Click"
                  AutomationProperties.Name="Показать тестовые данные локального примера" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel x:Name="ExamplePanel" Visibility="Collapsed">
      <DockPanel LastChildFill="False" Margin="0,0,0,10">
        <TextBlock Text="Балансы по площадкам" FontSize="18" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button x:Name="HistoryButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}"
                Content="_История" Margin="10,0,0,0" Click="History_Click"
                AutomationProperties.Name="Открыть историю закрытых сделок" />
      </DockPanel>

      <Border Background="#162A26" BorderBrush="#4A9B79" BorderThickness="1" CornerRadius="8"
              Padding="11,8" Margin="0,0,0,12" AutomationProperties.Name="Тестовые данные, локальный пример">
        <TextBlock Text="Тестовые данные · локальный пример; данные не связаны с аккаунтами и настройками."
                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
      </Border>

      <Border x:Name="OrderLifecyclePanel" Visibility="Collapsed"
              Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
              AutomationProperties.Name="Тестовые данные о частичном исполнении и выборе владельца">
        <StackPanel>
          <TextBlock Text="Частичное исполнение · только локальный пример" FontWeight="SemiBold"
                     AutomationProperties.Name="Локальный пример жизненного цикла Limit" />
          <TextBlock x:Name="OrderLifecycleOrderText" Margin="0,4,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="OrderLifecycleQuantitiesText" Margin="0,2,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="OrderLifecycleDeadlineText" Margin="0,2,0,0"
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="OrderLifecycleProtectionText" Margin="0,2,0,0"
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="OrderLifecycleOwnerChangeText" Margin="0,2,0,0"
                     Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ContinueOwnerParametersAction" Grid.Column="0"
                    Style="{StaticResource PrimaryAction}" Margin="0,0,4,0"
                    Click="ContinueOwnerParameters_Click"
                    AutomationProperties.Name="В локальном примере продолжить с новыми параметрами владельца">
              <TextBlock Text="Продолжить с новыми параметрами" TextWrapping="Wrap" />
            </Button>
            <Button x:Name="TransferToManualAction" Grid.Column="1"
                    Style="{StaticResource SecondaryAction}" Margin="4,0,0,0"
                    Click="TransferToManual_Click"
                    AutomationProperties.Name="В локальном примере передать позицию и остаток владельцу">
              <TextBlock Text="Передать владельцу" TextWrapping="Wrap" />
            </Button>
          </Grid>
          <TextBlock x:Name="OrderLifecycleDecisionStatusText" Margin="0,5,0,0"
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>

      <Border x:Name="EntryEligibilityPanel" Visibility="Collapsed"
              Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8"
              AutomationProperties.Name="Отдельный синтетический сценарий расчёта допуска">
        <StackPanel>
          <TextBlock Text="Тестовые данные · отдельный сценарий"
                     Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
          <TextBlock x:Name="EntryEligibilityStatusText" Margin="0,3,0,0" FontSize="14"
                     FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="EntryEligibilitySummaryText" Foreground="{StaticResource MutedBrush}"
                     Margin="0,1,0,0" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="Отдельный тестовый сценарий; неполный снимок ниже не используется."
                     Foreground="{StaticResource QuietBrush}" FontSize="10" Margin="0,2,0,0"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="EntryEligibilityMarketText" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" />
          <TextBlock x:Name="EntryEligibilitySizingText" Foreground="{StaticResource MutedBrush}"
                     Margin="0,1,0,0" FontSize="11" TextWrapping="Wrap" />
          <TextBlock x:Name="EntryEligibilityMarginText" Foreground="{StaticResource MutedBrush}"
                     Margin="0,1,0,0" FontSize="11" TextWrapping="Wrap" />
          <TextBlock x:Name="EntryEligibilityStressText" Foreground="{StaticResource MutedBrush}"
                     Margin="0,1,0,0" FontSize="11" TextWrapping="Wrap" />
          <TextBlock x:Name="EntryEligibilityCostsText" Foreground="{StaticResource MutedBrush}"
                     FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="EntryEligibilityTimesText" Foreground="{StaticResource QuietBrush}"
                     FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="EntryEligibilityVenueReasonsText" Foreground="{StaticResource QuietBrush}"
                     FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl x:Name="VenueCards">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding AvailabilityLabel}"
                             FontSize="12" FontWeight="SemiBold" Margin="10,2,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding AvailabilityLabel}" Value="Доступ утрачен">
                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Venue}" FontSize="17" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding AccountDetails}" Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AvailabilityDetails}" Margin="0,5,0,0" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AvailabilityLabel}" Value="Доступ утрачен">
                          <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Баланс и обеспечение" FontWeight="SemiBold" Margin="0,12,0,5" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Баланс без PnL" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Balance}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="5,0">
                    <TextBlock Text="Equity" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock Text="{Binding Equity}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="5,0,0,0">
                    <TextBlock Text="Доступная маржа" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AvailableMargin}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding BalanceStatus}" Foreground="{StaticResource QuietBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />

                <TextBlock Text="Открытые позиции" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="{Binding PositionStatus}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Positions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,5,0,0">
                        <TextBlock Text="{Binding Position}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UnrealizedPnl}" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Ownership}" Foreground="{StaticResource QuietBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PositionEmptyText}" Foreground="{StaticResource QuietBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Заявки" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="{Binding OrderStatus}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Orders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,5,0,0">
                        <TextBlock Text="{Binding Order}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Ownership}" Foreground="{StaticResource QuietBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Protection}" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding OrderEmptyText}" Foreground="{StaticResource QuietBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="TP/SL" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="{Binding ProtectionStatus}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Protections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Contract}" />
                        <Run Text=" · TP " />
                        <Run Text="{Binding TakeProfit}" />
                        <Run Text=" · SL " />
                        <Run Text="{Binding StopLoss}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ProtectionEmptyText}" Foreground="{StaticResource QuietBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Закрытые сделки" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="{Binding HistoryStatus}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button x:Name="ExitExampleButton" Style="{StaticResource SecondaryAction}"
              Content="_Вернуться к состоянию без данных" Click="ExitExample_Click"
              AutomationProperties.Name="Закрыть пример и вернуться к состоянию без данных"
              HorizontalAlignment="Left" />
    </StackPanel>
  </Grid>
</UserControl>
