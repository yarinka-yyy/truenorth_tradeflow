<UserControl x:Class="TrueNorth.TradeFlow.Account.AccountHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <UserControl.Resources>
    <Style TargetType="{x:Type DatePickerTextBox}">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
    </Style>
    <Style x:Key="AccountDatePicker" TargetType="{x:Type DatePicker}">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <StackPanel x:Name="NoDataPanel">
      <TextBlock Text="ИСТОРИЯ" Foreground="{StaticResource AccentBrush}" FontSize="11"
                 FontWeight="SemiBold" Margin="0,0,0,7" />
      <TextBlock Text="Закрытые сделки" FontSize="27" FontWeight="SemiBold" />
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="История счёта пока недоступна. Для локальной проверки откройте пример."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          <Button x:Name="ShowExampleButton" Style="{StaticResource PrimaryAction}"
                  Content="_Показать локальный пример" Click="ShowExample_Click" Margin="0,12,0,0"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="Показать тестовые данные истории локального примера" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel x:Name="ExamplePanel" Visibility="Collapsed">
      <DockPanel LastChildFill="False">
        <StackPanel>
          <TextBlock Text="ИСТОРИЯ" Foreground="{StaticResource AccentBrush}" FontSize="11"
                     FontWeight="SemiBold" Margin="0,0,0,7" />
          <TextBlock Text="Закрытые сделки" FontSize="27" FontWeight="SemiBold" />
        </StackPanel>
        <Button x:Name="BackToOverviewButton" DockPanel.Dock="Right"
                Style="{StaticResource SecondaryAction}" Content="_К обзору" Click="BackToOverview_Click"
                Margin="12,8,0,0" VerticalAlignment="Center"
                AutomationProperties.Name="Вернуться к обзору счёта" />
      </DockPanel>

      <Border Background="#162A26" BorderBrush="#4A9B79" BorderThickness="1" CornerRadius="8"
              Padding="11,8" Margin="0,12,0,12" AutomationProperties.Name="Тестовые данные, локальный пример">
        <TextBlock Text="Тестовые данные · локальный пример; данные не связаны с аккаунтами и настройками."
                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
      </Border>

      <TextBlock Text="Фильтры по площадке и дате закрытия. Суммы остаются в валюте каждой сделки."
                 Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <WrapPanel>
        <StackPanel Width="132" Margin="0,0,8,8">
          <TextBlock Text="Площадка" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
          <ComboBox x:Name="HistoryVenueFilter" Style="{StaticResource FormComboBox}"
                    SelectionChanged="Filter_Changed"
                    Focusable="True" IsTabStop="True"
                    AutomationProperties.Name="Фильтр истории по площадке" />
        </StackPanel>
        <StackPanel Width="132" Margin="0,0,8,8">
          <TextBlock Text="Закрыта с" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
          <DatePicker x:Name="ClosedFromFilter" Style="{StaticResource AccountDatePicker}"
                      SelectedDateChanged="Filter_Changed" Focusable="True" IsTabStop="True"
                      AutomationProperties.Name="Начало периода закрытия" />
        </StackPanel>
        <StackPanel Width="132" Margin="0,0,8,8">
          <TextBlock Text="Закрыта по" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
          <DatePicker x:Name="ClosedToFilter" Style="{StaticResource AccountDatePicker}"
                      SelectedDateChanged="Filter_Changed" Focusable="True" IsTabStop="True"
                      AutomationProperties.Name="Конец периода закрытия" />
        </StackPanel>
        <Button x:Name="ResetFiltersButton" Style="{StaticResource SecondaryAction}"
                Content="_Сбросить фильтры" Click="ResetFilters_Click" Margin="0,0,8,8"
                AutomationProperties.Name="Сбросить фильтры истории" />
      </WrapPanel>

      <TextBlock x:Name="FilterSummaryText" Foreground="{StaticResource QuietBrush}"
                 FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
      <TextBlock x:Name="EmptyFilteredText" Foreground="{StaticResource MutedBrush}"
                 Text=""
                 Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap" />

      <ItemsControl x:Name="TradeRows">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Venue}" Foreground="{StaticResource MutedBrush}"
                             Margin="10,0,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Asset}" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding Direction}" Foreground="{StaticResource MutedBrush}"
                           Margin="0,3,0,0" />
                <TextBlock Text="{Binding OpenedAt}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ClosedAt}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RealizedPnl}" FontWeight="SemiBold" Margin="0,5,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding CloseReason}" Foreground="{StaticResource MutedBrush}"
                           Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SnapshotLabel}" Foreground="{StaticResource WarningBrush}"
                           Margin="0,5,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button x:Name="ExitExampleButton" Style="{StaticResource SecondaryAction}"
              Content="_Закрыть пример" Click="ExitExample_Click" HorizontalAlignment="Left"
              AutomationProperties.Name="Закрыть пример и вернуться к пустой истории" />
    </StackPanel>
  </Grid>
</UserControl>
