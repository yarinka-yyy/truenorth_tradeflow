<Window x:Class="TrueNorth.TradeFlow.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завершить работу?" SizeToContent="WidthAndHeight" MinWidth="390" MaxWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Border Padding="26" Background="{StaticResource CanvasBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Завершить работу?" FontSize="20" FontWeight="SemiBold" />
      <StackPanel Grid.Row="1" Margin="0,14,0,22">
        <TextBlock Text="Выход остановит мониторинг." TextWrapping="Wrap" />
        <TextBlock Text="Сейчас мониторинг не запущен." Foreground="{StaticResource MutedBrush}"
                   Margin="0,7,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Вернуться" IsCancel="True" IsDefault="True" MinWidth="110" Padding="14,8" Margin="0,0,10,0"
                AutomationProperties.Name="Вернуться в приложение" />
        <Button Content="Выйти" IsDefault="False" MinWidth="86" Padding="14,8"
                Click="Exit_Click" AutomationProperties.Name="Завершить работу приложения" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
