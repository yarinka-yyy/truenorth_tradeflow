<Window x:Class="TrueNorth.TradeFlow.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завершить работу?" SizeToContent="WidthAndHeight" MinWidth="430" MaxWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Border Padding="26" Background="{StaticResource CanvasBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Завершить работу?" FontSize="20" FontWeight="SemiBold" />
      <StackPanel Grid.Row="1" Margin="0,14,0,22">
        <TextBlock x:Name="ExitEntriesText" FontWeight="SemiBold" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="ExitStatusText" Foreground="{StaticResource MutedBrush}"
                   Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="ExitResultsText" Foreground="{StaticResource WarningBrush}"
                   Margin="0,7,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="Существующие позиции останутся открытыми. Возврат сначала сверит состояние и восстановит сохранённый режим."
                   Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel Grid.Row="2" HorizontalAlignment="Right" FlowDirection="RightToLeft">
        <Button x:Name="LeaveButton" Content="Выйти" IsDefault="False" MinWidth="100" Padding="14,8"
                Margin="8,0,0,0" Click="Leave_Click"
                AutomationProperties.Name="Оставить заявки и завершить работу"
                Focusable="True" IsTabStop="True" />
        <Button x:Name="CancelEntriesButton" Content="Отменить заявки" MinWidth="138" Padding="14,8"
                Margin="8,0,0,0" Click="CancelEntries_Click"
                AutomationProperties.Name="Отменить подтверждённые программные заявки и завершить работу"
                Focusable="True" IsTabStop="True" />
        <Button x:Name="ReturnButton" Content="Вернуться" IsCancel="True" IsDefault="True"
                MinWidth="110" Padding="14,8" Click="Return_Click"
                AutomationProperties.Name="Вернуться в приложение"
                Focusable="True" IsTabStop="True" />
      </WrapPanel>
    </Grid>
  </Border>
</Window>
